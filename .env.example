# ============================================================
# XuanMu RedTeam Agent - Docker 部署环境变量
# 使用方式：复制此文件为 .env，然后根据需要修改
#   cp .env.example .env
# ============================================================

# ---- 服务端口 ----
# Web 界面访问端口（浏览器打开 http://localhost:8000）
XUANMU_PORT=8000
# PostgreSQL 外部访问端口（用于调试，可改为不暴露）
POSTGRES_PORT=5400

# ---- 数据库配置 ----
# 注意：这里的值必须和 .xuanmu/config.json 中 database 部分保持一致
POSTGRES_USER=root
POSTGRES_PASSWORD=changeme
POSTGRES_DB=z3r0

# ---- pgAdmin（可选）----
# 通过 --profile admin 启用 pgAdmin 时使用
PGADMIN_EMAIL=admin@xuanmu.local
PGADMIN_PASSWORD=changeme
PGADMIN_PORT=5401

# ---- 时区 ----
TZ=Asia/Shanghai
