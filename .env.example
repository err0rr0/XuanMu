# ============================================================
# XuanMu RedTeam Agent - Docker 部署环境变量
# 使用方式：复制此文件为 .env，按需修改后启动
#   cp .env.example .env
# ============================================================

# ---- 服务端口 ----
XUANMU_PORT=8000
POSTGRES_PORT=5400

# ---- 数据库配置 ----
# 重要：修改后必须同步更新 .xuanmu/config.json 中的 database 部分
# 重要：如果已经启动过，修改密码需要先 bash docker-setup.sh clean 清除旧数据卷
POSTGRES_USER=root
POSTGRES_PASSWORD=xuanmu2025
POSTGRES_DB=z3r0

# ---- pgAdmin（可选，通过 --profile admin 启用）----
PGADMIN_EMAIL=admin@xuanmu.local
PGADMIN_PASSWORD=xuanmu2025
PGADMIN_PORT=5401

# ---- 时区 ----
TZ=Asia/Shanghai
