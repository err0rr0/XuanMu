# ============================================================
# XuanMu RedTeam Agent - Docker 部署环境变量
#
# 使用方式：复制此文件为 .env，按需修改后启动
#   cp .env.example .env
#
# 改端口？改数据库密码？只改这个文件就行，不用动其他配置。
# ============================================================

# ---- 应用端口 ----
# 改这一个值就能改 Web 访问端口（浏览器打开 http://localhost:8000）
# 容器内监听端口会自动同步，无需改 config.json
XUANMU_PORT=8000

# ---- 数据库配置 ----
# 改这里会自动同步到 app 容器，无需手动改 config.json
# 注意：如果已经启动过，改密码需要先 bash docker-setup.sh clean 清除旧数据卷
POSTGRES_USER=root
POSTGRES_PASSWORD=xuanmu2025
POSTGRES_DB=z3r0

# ---- PostgreSQL 外部访问端口（调试用）----
POSTGRES_PORT=5400

# ---- pgAdmin（可选，通过 --profile admin 启用）----
PGADMIN_EMAIL=admin@xuanmu.local
PGADMIN_PASSWORD=xuanmu2025
PGADMIN_PORT=5401

# ---- 时区 ----
TZ=Asia/Shanghai
